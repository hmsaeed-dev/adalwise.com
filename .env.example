# YouTube Data API Configuration (Get yours at https://console.cloud.google.com)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Site Production Domain
NEXT_PUBLIC_SITE_URL=https://Adlwise.com

# Email Notifications via Resend (https://resend.com)
RESEND_API_KEY=
# Inbox where applications are delivered (defaults to founder@adlwise.com)
ADMIN_NOTIFICATION_EMAIL=founder@adlwise.com
# From address (use onboarding@resend.dev for testing, or verified domain e.g. fellowship@adlwise.com)
RESEND_FROM_EMAIL=Adlwise Intake <onboarding@resend.dev>

# Automated Google Sheet Ledger (Free Google Apps Script Webhook)
# Also accepts FELLOWSHIP_WEBHOOK_URL
GOOGLE_SHEET_WEBHOOK_URL=
FELLOWSHIP_WEBHOOK_URL=

